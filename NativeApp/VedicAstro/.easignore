# EAS Build ignore file - keeps the upload small and fast

# Dependencies (EAS installs these on the build server)
node_modules/

# Expo generated files
.expo/
dist/
web-build/

# Native build outputs
android/
ios/
.kotlin/

# Development / debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS files
.DS_Store
Thumbs.db

# Environment / secrets (add real values via EAS Secrets instead)
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript cache
*.tsbuildinfo

# Editor
.vscode/
.idea/

# Test files
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
