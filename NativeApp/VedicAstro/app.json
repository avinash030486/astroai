{
  "expo": {
    "name": "Vedic Astro",
    "slug": "astroai",
    "version": "1.0.3",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/vedicastro-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/vedicastro-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E2A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vedicastro.astro"
    },
    "android": {
      "package": "app.vedicastro.astro",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E2A",
        "foregroundImage": "./assets/vedicastro-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/vedicastro-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "CAMERA",
        "com.android.vending.BILLING",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/vedicastro-logo.png"
    },
    "scheme": "vedicastro",
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "react-native-iap",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "VedicAstro uses your camera to show planet positions overlaid on the live sky view."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VedicAstro uses your location to calculate accurate planet positions in your sky."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "df4ab516-efce-4543-8104-491a9a796868"
      }
    },
    "owner": "vedicastroapp"
  }
}
