{
  "expo": {
    "name": "VedicAstro",
    "slug": "VedicAstro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vedicastro-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/vedicastro-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E2A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E2A",
        "foregroundImage": "./assets/vedicastro-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/vedicastro-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/vedicastro-logo.png"
    },
    "scheme": "vedicastro",
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ]
  }
}
