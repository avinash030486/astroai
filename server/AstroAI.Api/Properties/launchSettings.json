{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASTROAI_OPENAI_ENDPOINT": "https://your-openai-endpoint/chat/completions",
        "ASTROAI_OPENAI_API_KEY": "YOUR_API_KEY_HERE",
        "ASTROAI_MODEL_ID": "gpt-5.2"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:5001;http://localhost:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASTROAI_OPENAI_ENDPOINT": "https://your-openai-endpoint/chat/completions",
        "ASTROAI_OPENAI_API_KEY": "YOUR_API_KEY_HERE",
        "ASTROAI_MODEL_ID": "gpt-5.2"
      }
    }
  }
}
